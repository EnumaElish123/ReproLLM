+R08B_BINDINGS = [
+    ("privacy.mechanism.params.target_epsilon", 8.0, 4.0),
+    ("privacy.mechanism.params.target_delta", 0.001, 0.0001),
+    ("privacy.mechanism.params.max_grad_norm", 1.0, 0.5),
+    ("training.params.num_train_epochs", 0.125, 0.25),

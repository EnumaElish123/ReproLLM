+    assert finding["evidence"][2]["field"] == "audit.ignore"
+    assert finding["evidence"][2]["note"] == (
+        "suppressed: original severity INFO; reason: Reviewed incomplete import-origin evidence."
+    )
+    assert report["summary"] == {
+        "critical": 0,
+        "warning": 0,
+        "info": 0,
+        "pass": 0,
+        "suppressed": 1,
+        "skipped": 0,
+    }

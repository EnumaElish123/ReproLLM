      "redactions": 1
    },
    {
      "case": "decoded-scalar",
      "contextual_parser_preserves": true,
      "path_matches": [],
      "privacy_preserves": true,
      "redactions": 0
    },
    {
      "case": "role-word-instead-of-letter",
      "contextual_parser_preserves": true,
      "path_matches": [],
      "privacy_preserves": true,
      "redactions": 0
    },
    {
      "case": "space-instead-of-newline",
      "contextual_parser_preserves": true,
      "path_matches": [],
      "privacy_preserves": true,
      "redactions": 0
    },
    {
      "case": "actual-windows-path",
      "contextual_parser_preserves": true,

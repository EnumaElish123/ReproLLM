    @pytest.mark.parametrize("template", [None, "neurips", "acl", "acm"])
    def test_consumed_input_baseline_survives_state_and_every_export_template(
        tmp_path: Path, stub_run_cmd: CmdStub, template: str | None
    ) -> None:
        initial = b'{"temperature": 0.1}\n'
        final = b'{"temperature": 0.9}\n'
        (tmp_path / "config.json").write_bytes(initial)
        (tmp_path / "reprollm.yaml").write_bytes(
            b"schema_version: 1\nproject: {name: input-baseline}\nexperiment: {profiles: []}\n"
            b"generation: {temperature: 0.1}\n"
            b"bindings:\n  generation.temperature: {config: 'config.json:temperature'}\n"
            b"execution: {config_files: [config.json]}\n"
            b"artifacts: {outputs: [consumed.json]}\n"
        )
        stub_run_cmd.on("git", returncode=128)
        stub_run_cmd.on("nvidia-smi", returncode=1)

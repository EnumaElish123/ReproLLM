            "import json; from pathlib import Path; "
            "value=json.loads(Path('config.json').read_bytes())['temperature']; "
            "Path('consumed.json').write_text(json.dumps({'schema_version':1,'temperature':value})); "
            "Path('config.json').write_bytes(b'{\"temperature\": 0.9}\\n')"
        )
        run_dir = create_run_dir(tmp_path)
        record = execute(
            [sys.executable, "-c", code],

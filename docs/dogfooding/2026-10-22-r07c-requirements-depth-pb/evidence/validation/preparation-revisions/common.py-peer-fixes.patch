+def verify_synthetic_oracle(root=TOOLS):
+    root = Path(root)
+    expected = read(root/'synthetic-plan.json')['expected_files']
+    actual = {p.relative_to(root).as_posix(): digest(p.read_bytes())
+              for p in (root/'synthetic-expected').rglob('*') if p.is_file()}
+    assert len(expected) == 18, 'Synthetic oracle must have exactly 18 complete reports'
+    assert actual.keys() == expected.keys(), 'Synthetic oracle paths changed'
+    assert actual == expected, 'Synthetic oracle body hash changed'
+    return dict(plan_sha256=digest((root/'synthetic-plan.json').read_bytes()), files=len(expected))

+        (project / "a.py").write_text("import torch\n", encoding="utf-8")
+    monkeypatch.setattr("reprollm.rules.env.installed_versions", lambda: {})
+
+    warning, skipped = LlmCriticalDepsPinnedRule().check(_format_credit_context(tmp_path))

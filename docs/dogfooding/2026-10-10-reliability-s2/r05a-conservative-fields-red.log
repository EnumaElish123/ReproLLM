        if text is None:
            result.unparsed.append(f"{path}:0: unreadable")
            return False
        try:
            doc = tomllib.loads(text)
        except tomllib.TOMLDecodeError as exc:
            result.unparsed.append(f"{path}:0: {exc}")
            return False

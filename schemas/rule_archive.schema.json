{
  "$defs": {
    "ProjectRule": {
      "additionalProperties": false,
      "description": "One accepted rule; FAIL when ``field`` is absent/null in the manifest.",
      "properties": {
        "accepted_at": {
          "format": "date-time",
          "title": "Accepted At",
          "type": "string"
        },
        "bindings": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProjectRuleBindings"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "candidate_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Candidate Id"
        },
        "field": {
          "title": "Field",
          "type": "string"
        },
        "id": {
          "pattern": "^project\\.[a-z][a-z0-9_]{0,47}$",
          "title": "Id",
          "type": "string"
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "severity": {
          "enum": [
            "CRITICAL",
            "WARNING",
            "INFO"
          ],
          "title": "Severity",
          "type": "string"
        },
        "source": {
          "enum": [
            "manual",
            "discover"
          ],
          "title": "Source",
          "type": "string"
        }
      },
      "required": [
        "id",
        "field",
        "severity",
        "reason",
        "source",
        "accepted_at"
      ],
      "title": "ProjectRule",
      "type": "object"
    },
    "ProjectRuleBindings": {
      "additionalProperties": false,
      "properties": {
        "cli": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cli"
        },
        "config": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Config"
        },
        "env": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Env"
        }
      },
      "title": "ProjectRuleBindings",
      "type": "object"
    }
  },
  "$id": "https://reprollm.dev/schemas/rule_archive.schema.json",
  "additionalProperties": false,
  "description": "A saved rule, not proof that deactivation completed successfully.",
  "properties": {
    "archive_id": {
      "pattern": "^ra-[0-9a-f]{16}$",
      "title": "Archive Id",
      "type": "string"
    },
    "archived_at": {
      "format": "date-time",
      "title": "Archived At",
      "type": "string"
    },
    "reason": {
      "minLength": 1,
      "title": "Reason",
      "type": "string"
    },
    "rule": {
      "$ref": "#/$defs/ProjectRule"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    }
  },
  "required": [
    "archive_id",
    "archived_at",
    "reason",
    "rule"
  ],
  "title": "RuleArchive",
  "type": "object"
}
